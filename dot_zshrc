# Over ssh, the local terminal's TERM (xterm-ghostty) may have no terminfo
# entry on the remote. Fall back rather than break backspace and the TUIs.
[[ -n $TERM ]] && ! infocmp "$TERM" &>/dev/null && export TERM=xterm-256color

if [[ -d "$HOME/.jenv" ]]; then
  export PATH="$HOME/.jenv/bin:$PATH"
  eval "$(jenv init -)"
fi
export PATH="$HOME/.local/bin:$PATH"

# Prompt, colors, and tool aliases (edit that file, not this one).
[[ -f ~/.config/zsh/theme.zsh ]] && source ~/.config/zsh/theme.zsh

# Host-specific aliases and secrets. Stays out of the dotfiles repo.
[[ -f ~/.config/zsh/local.zsh ]] && source ~/.config/zsh/local.zsh
