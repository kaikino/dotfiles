# Identity comes from ~/.config/chezmoi/chezmoi.toml, set on `chezmoi init`,
# so a work machine commits as the work account.
[user]
	name = {{ .name }}
	email = {{ .email }}

# ══════════════════════════════════════════════════════════════════════
#  Diffs through delta — syntax highlighting, real line numbers,
#  square-ruled headers. Backgrounds are the only hardcoded hex here:
#  ANSI red/green are too loud as a fill, so these are dialed-down
#  navy-compatible washes.
# ══════════════════════════════════════════════════════════════════════
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = base16
	file-style = bold blue
	file-decoration-style = bright-black ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = bright-black ul
	line-numbers-left-style = bright-black
	line-numbers-right-style = bright-black
	line-numbers-zero-style = bright-black
	line-numbers-minus-style = red
	line-numbers-plus-style = green
	minus-style = syntax "#2A1319"
	minus-emph-style = syntax "#4A1C26"
	plus-style = syntax "#10231C"
	plus-emph-style = syntax "#1B3A2E"
	zero-style = syntax
	whitespace-error-style = bright-red reverse

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[color]
	ui = auto

[color "status"]
	added = green
	changed = yellow
	untracked = brightblack
