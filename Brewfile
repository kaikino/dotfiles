# ── Core: personalization only ────────────────────────────────────────
# What makes a shell feel like mine — prompt, colours, editor, the
# commands the aliases in theme.zsh assume. Nothing project-related.
# Everything else lives in Brewfile.dev / .desktop / .personal.

brew "starship"               # prompt
brew "atuin"                  # history
brew "fzf"                    # Ctrl-T / Alt-C / Tab pickers
brew "fd"                     #   fzf's file source
brew "ripgrep"                #   grep alias, telescope, fzf
brew "eza"                    # ls
brew "bat"                    # cat, man
brew "git-delta"              # git diff
brew "lazygit"                # git
brew "yazi"                   # files
brew "poppler"                #   yazi preview: PDF
brew "resvg"                  #   yazi preview: SVG
brew "sevenzip"               #   yazi preview: archives
brew "btop"                   # top
brew "neovim"                 # editor
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "chezmoi"                # this repo
cask "font-hack-nerd-font"
