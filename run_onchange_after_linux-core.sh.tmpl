#!/bin/bash
# ══════════════════════════════════════════════════════════════════════
#  Linux core install. The distro's packages are too old for this config
#  (Ubuntu 24.04: nvim 0.9 lacks vim.uv, fzf 0.44 lacks `fzf --zsh`), so
#  core comes from Homebrew on Linux, same versions as the Mac. Reruns
#  whenever the Brewfile changes. Casks are macOS-only and filtered out.
#  Brewfile hash: {{ include "Brewfile" | sha256sum }}
# ══════════════════════════════════════════════════════════════════════
[[ "$(uname)" == "Linux" ]] || exit 0
set -euo pipefail

if command -v apt-get >/dev/null; then
  pkgs=(build-essential curl git zsh file procps)
  missing=()
  for p in "${pkgs[@]}"; do dpkg -s "$p" &>/dev/null || missing+=("$p"); done
  if (( ${#missing[@]} )); then
    sudo apt-get update -qq && sudo apt-get install -y -qq "${missing[@]}"
  fi
fi

brew=/home/linuxbrew/.linuxbrew/bin/brew
if [[ ! -x $brew ]]; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$($brew shellenv)"

grep -v '^cask ' "{{ .chezmoi.sourceDir }}/Brewfile" | brew bundle --file=-

# Login shell → zsh. Fails harmlessly under OS Login, where the account
# isn't in /etc/passwd; the README has the ~/.bashrc fallback for that.
zsh_path="$(command -v zsh)"
if [[ "$(getent passwd "$USER" | cut -d: -f7)" != "$zsh_path" ]]; then
  sudo chsh -s "$zsh_path" "$USER" || echo "chsh failed; see README (Linux)." >&2
fi
