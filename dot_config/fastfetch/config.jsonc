// fastfetch — shown once per new top-level shell. Navy/oxblood apple,
// keys in blue, a palette strip at the bottom. Trimmed to what's worth
// reading every day; `fastfetch --list-modules` for more.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "macos_small",
    "color": { "1": "blue", "2": "blue", "3": "red", "4": "red", "5": "blue", "6": "blue" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": " ",
    "key": { "width": 10 },
    "color": { "keys": "blue", "title": "red" }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "packages" },
    { "type": "shell",    "key": "shell" },
    { "type": "terminal", "key": "terminal" },
    { "type": "wm",       "key": "wm" },
    { "type": "cpu",      "key": "cpu" },
    { "type": "memory",   "key": "memory" },
    { "type": "disk",     "key": "disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "block", "block": { "width": 3 }, "paddingLeft": 0 }
  ]
}
